{
  "compilerOptions": {
    "target": "ES2023",
    "module": "commonjs",
    "lib": [
      "ES2023"
    ],
    "declaration": true,
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": "./",
    "paths": {
      "@hockpay/core": [
        "../../packages/core/src"
      ],
      "@hockpay/core/*": [
        "../../packages/core/src/*"
      ],
      "@hockpay/database": [
        "../../packages/database/src"
      ],
      "@hockpay/database/*": [
        "../../packages/database/src/*"
      ],
      "@hockpay/infrastructure": [
        "../../packages/infrastructure/src"
      ],
      "@hockpay/infrastructure/*": [
        "../../packages/infrastructure/src/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.spec.ts",
    "**/*.test.ts"
  ]
}