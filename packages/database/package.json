{
  "name": "@hockpay/database",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./nest": {
      "types": "./dist/nest/index.d.ts",
      "require": "./dist/nest/index.js",
      "default": "./dist/nest/index.js"
    }
  },
  "scripts": {
    "build": "tsc && cp -R src/generated dist/ && mkdir -p dist/prisma/migrations && cp prisma/schema.prisma dist/prisma/schema.prisma && cp -R prisma/migrations/. dist/prisma/migrations/ && cp prisma.config.ts dist/prisma.config.ts",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "format": "prettier --write \"src/index.ts\" \"src/nest/**/*.ts\"",
    "format:check": "prettier --check \"src/index.ts\" \"src/nest/**/*.ts\" --no-error-on-unmatched-pattern",
    "lint": "eslint \"src/index.ts\" \"src/nest/**/*.ts\" --fix",
    "lint:check": "eslint \"src/index.ts\" \"src/nest/**/*.ts\""
  },
  "dependencies": {
    "@prisma/client": "^6.19.2"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3"
  },
  "peerDependenciesMeta": {
    "@nestjs/common": {
      "optional": true
    },
    "@nestjs/config": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
