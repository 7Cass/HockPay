// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  output     = "../src/generated/prisma"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Environment {
  TEST
  LIVE
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  RELEASED
  EXPIRED
  FAILED
  REFUNDED
}

enum PixChargeStatus {
  OPEN
  PAID
  EXPIRED
  CANCELLED
}

enum SessionStatus {
  OPEN
  COMPLETED
  EXPIRED
}

enum CustomerCollectionMode {
  IDENTIFIED
  GUEST
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum TransactionType {
  PAYMENT_RECEIVED
  PAYMENT_RELEASED
  REFUND_DEDUCTED
  NEGATIVE_COMPENSATED
  WITHDRAWAL_RESERVED
  WITHDRAWAL_SENT
  WITHDRAWAL_REVERSED
  FEE_CHARGED
  ADJUSTMENT
}

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  RANDOM
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  PROCESSED
  FAILED
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  BOLETO
  DEBIT_CARD
}

enum ReceiptStatus {
  ISSUED
  CANCELLED
}

enum AlertChannel {
  DISCORD
}

enum AlertDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED_RETRYABLE
  FAILED_FINAL
}

// ============================================================================
// MERCHANT & AUTH
// ============================================================================

model Merchant {
  id              String         @id @default(uuid())
  email           String         @unique
  passwordHash    String         @map("password_hash")
  name            String
  document        String         @unique
  isActive        Boolean        @default(true) @map("is_active")
  currentStoreId  String?        @map("current_store_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  stores          Store[]
  refreshTokens   RefreshToken[]

  @@map("merchants")
}

model RefreshToken {
  id          String      @id @default(uuid())
  token       String      @unique
  merchantId  String      @unique @map("merchant_id")
  expiresAt   DateTime    @map("expires_at")
  revokedAt   DateTime?   @map("revoked_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  merchant    Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// ============================================================================
// STORE & FINANCIAL
// ============================================================================

model Store {
  id              String            @id @default(uuid())
  merchantId      String            @map("merchant_id")
  name            String
  slug            String            @unique
  isActive        Boolean           @default(true) @map("is_active")
  isApproved      Boolean           @default(false) @map("is_approved")
  settlementDays  Int               @default(30) @map("settlement_days")
  feePercent      Decimal           @default(1.5) @map("fee_percent") @db.Decimal(5, 2)
  feeFixed        Int               @default(15) @map("fee_fixed")
  city            String?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  merchant        Merchant          @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  account         Account?
  apiKeys         ApiKey[]
  bankAccounts    BankAccount[]
  customers       Customer[]
  products        Product[]
  payments        Payment[]
  pixCharges      PixCharge[]
  checkoutSessions CheckoutSession[]
  paymentLinks    PaymentLink[]
  webhookConfigs  WebhookConfig[]
  webhookInboxEvents WebhookInboxEvent[]
  alertConfigs    AlertConfig[]
  idempotencyKeys IdempotencyKey[]
  receipts        Receipt[]
  receiptCounters ReceiptCounter[]

  @@map("stores")
}

model BankAccount {
  id              String        @id @default(uuid())
  storeId         String        @map("store_id")
  pixKey          String        @map("pix_key")
  pixKeyType      PixKeyType    @map("pix_key_type")
  holderName      String        @map("holder_name")
  holderDocument  String        @map("holder_document")
  isDefault       Boolean       @default(false) @map("is_default")
  isVerified      Boolean       @default(false) @map("is_verified")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  withdrawals     Withdrawal[]

  @@map("bank_accounts")
}

model Account {
  id            String        @id @default(uuid())
  storeId       String        @unique @map("store_id")
  available     Int           @default(0)
  pending       Int           @default(0)
  blocked       Int           @default(0)
  currency      String        @default("BRL")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  withdrawals   Withdrawal[]

  @@map("accounts")
}

model Transaction {
  id            String          @id @default(uuid())
  accountId     String          @map("account_id")
  type          TransactionType
  amount        Int
  fee           Int             @default(0)
  netAmount     Int             @map("net_amount")
  balanceAfter  Int             @map("balance_after")
  referenceType String?         @map("reference_type")
  referenceId   String?         @map("reference_id")
  description   String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  account       Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Withdrawal {
  id              String              @id @default(uuid())
  accountId       String              @map("account_id")
  bankAccountId   String              @map("bank_account_id")
  amount          Int
  fee             Int                 @default(0)
  netAmount       Int                 @map("net_amount")
  environment     Environment         @default(TEST)
  status          WithdrawalStatus
  pixE2eId        String?             @map("pix_e2e_id")
  paidAt          DateTime?           @map("paid_at")
  failedReason    String?             @map("failed_reason")
  processingAttempts Int              @default(0) @map("processing_attempts")
  nextProcessAt   DateTime?           @map("next_process_at")
  lastProcessingError String?         @map("last_processing_error") @db.Text
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  account         Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bankAccount     BankAccount         @relation(fields: [bankAccountId], references: [id], onDelete: Restrict)

  @@index([accountId, status, createdAt])
  @@index([bankAccountId])
  @@index([status, nextProcessAt])
  @@index([status, nextProcessAt, createdAt])
  @@index([status, updatedAt, createdAt])
  @@map("withdrawals")
}

// ============================================================================
// CUSTOMER & PRODUCT
// ============================================================================

model Customer {
  id          String      @id @default(uuid())
  storeId     String      @map("store_id")
  externalId  String?     @map("external_id")
  name        String?
  email       String?
  document    String
  phone       String?
  street      String?     @map("street")
  number      String?     @map("number")
  complement  String?     @map("complement")
  city        String?     @map("city")
  state       String?     @map("state")
  zipCode     String?     @map("zip_code")
  country     String?     @default("BR") @map("country")
  metadata    Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payments    Payment[]

  @@unique([storeId, document])
  @@unique([storeId, externalId])
  @@map("customers")
}

model Product {
  id          String        @id @default(uuid())
  storeId     String        @map("store_id")
  externalId  String?       @map("external_id")
  name        String
  description String?
  price       Int
  currency    String        @default("BRL")
  imageUrl    String?       @map("image_url")
  metadata    Json?
  environment Environment   @default(TEST)
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  paymentItems  PaymentItem[]
  checkoutSessionItems CheckoutSessionItem[]
  paymentLinkItems     PaymentLinkItem[]

  @@unique([storeId, environment, externalId])
  @@index([storeId, environment, isActive])
  @@index([storeId, environment, createdAt(sort: Desc)])
  @@map("products")
}

model PaymentItem {
  id                String    @id @default(uuid())
  paymentId         String    @map("payment_id")
  productId         String?   @map("product_id")
  productExternalId String?   @map("product_external_id")
  name              String
  description       String?
  quantity          Int       @default(1)
  unitPrice         Int       @map("unit_price")
  totalPrice        Int       @map("total_price")
  imageUrl          String?   @map("image_url")
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  payment           Payment   @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  product           Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([productId])
  @@map("payment_items")
}

// ============================================================================
// PAYMENT
// ============================================================================

model Payment {
  id            String          @id @default(uuid())
  storeId       String          @map("store_id")
  customerId    String?         @map("customer_id")
  pixChargeId   String?         @map("pix_charge_id")
  externalId    String?         @map("external_id")
  amount        Int
  fee           Int
  netAmount     Int             @map("net_amount")
  currency      String          @default("BRL")
  description   String?
  payerName     String?         @map("payer_name")
  payerDocument String?         @map("payer_document")
  payerEmail    String?         @map("payer_email")
  status        PaymentStatus
  environment   Environment     @default(TEST)
  paymentMethod PaymentMethod   @default(PIX) @map("payment_method")
  paymentDetails Json?          @map("payment_details")
  acquirerId    String?         @map("acquirer_id")
  totalRefunded Int             @default(0) @map("total_refunded")
  expiresAt     DateTime        @map("expires_at")
  paidAt        DateTime?       @map("paid_at")
  releasedAt    DateTime?       @map("released_at")
  failedReason  String?         @map("failed_reason")
  metadata      Json?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  store         Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer      Customer?       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  pixCharge     PixCharge?      @relation(fields: [pixChargeId], references: [id], onDelete: SetNull)
  checkoutSession CheckoutSession?
  items         PaymentItem[]
  refunds       Refund[]
  receipt       Receipt?
  webhookLogs   WebhookLog[]
  webhookInboxEvents WebhookInboxEvent[]

  @@unique([storeId, environment, externalId])
  @@index([storeId, status])
  @@index([storeId, createdAt(sort: Desc)])
  @@index([pixChargeId])
  @@index([expiresAt])
  // Prisma cannot express the partial unique index created in
  // 20260523093000_unique_paid_payment_per_pix_charge:
  // payments_one_paid_per_pix_charge_idx ON pix_charge_id
  // WHERE status IN (CONFIRMED, RELEASED). Do not db push this model
  // without re-applying that SQL; failed/pending attempts remain allowed.
  @@map("payments")
}

model PixCharge {
  id            String          @id @default(uuid())
  storeId       String          @map("store_id")
  amount        Int
  currency      String          @default("BRL")
  status        PixChargeStatus @default(OPEN)
  pixQrCode     String          @map("pix_qr_code")
  pixCopyPaste  String          @map("pix_copy_paste") @db.Text
  pixTxId       String          @unique @map("pix_tx_id")
  expiresAt     DateTime?       @map("expires_at")
  paidAt        DateTime?       @map("paid_at")
  cancelledAt   DateTime?       @map("cancelled_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  store         Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payments      Payment[]
  paymentLink   PaymentLink?

  @@index([storeId, status])
  @@index([expiresAt])
  @@map("pix_charges")
}

// ============================================================================
// CHECKOUT SESSION
// ============================================================================

model CheckoutSession {
  id              String         @id @default(uuid())
  storeId         String         @map("store_id")
  amount          Int
  currency        String         @default("BRL")
  environment     Environment    @default(TEST)
  description     String?
  customerCollectionMode CustomerCollectionMode @default(IDENTIFIED) @map("customer_collection_mode")
  prefillCustomer Json?          @map("prefill_customer")
  paymentId       String?        @unique @map("payment_id")
  checkoutToken   String         @unique @map("checkout_token")
  status          SessionStatus  @default(OPEN)
  expiresAt       DateTime       @map("expires_at")
  successUrl      String?        @map("success_url")
  cancelUrl       String?        @map("cancel_url")
  metadata        Json?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  store           Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  payment         Payment?       @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  items           CheckoutSessionItem[]

  @@map("checkout_sessions")
}

model CheckoutSessionItem {
  id                String          @id @default(uuid())
  checkoutSessionId String          @map("checkout_session_id")
  productId         String?         @map("product_id")
  productExternalId String?         @map("product_external_id")
  name              String
  description       String?
  quantity          Int             @default(1)
  unitPrice         Int             @map("unit_price")
  totalPrice        Int             @map("total_price")
  imageUrl          String?         @map("image_url")
  metadata          Json?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  checkoutSession   CheckoutSession @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([checkoutSessionId])
  @@index([productId])
  @@map("checkout_session_items")
}

model PaymentLink {
  id                String          @id @default(uuid())
  storeId           String          @map("store_id")
  pixChargeId       String          @unique @map("pix_charge_id")
  publicToken       String          @unique @map("public_token")
  amount            Int
  currency          String          @default("BRL")
  environment       Environment     @default(TEST)
  title             String?
  description       String?
  internalReference String?         @map("internal_reference")
  expiresAt         DateTime?       @map("expires_at")
  openedAt          DateTime?       @map("opened_at")
  cancelledAt       DateTime?       @map("cancelled_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  store             Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  pixCharge         PixCharge       @relation(fields: [pixChargeId], references: [id], onDelete: Restrict)
  items             PaymentLinkItem[]

  @@index([storeId, createdAt(sort: Desc)])
  @@index([storeId, openedAt])
  @@index([storeId, cancelledAt])
  @@map("payment_links")
}

// Snapshot dos itens no momento da criacao do link. O valor do link e a
// PixCharge/BR Code EMV sao congelados na criacao, entao o item guarda nome,
// preco e imagem daquele instante e nao acompanha edicoes posteriores do
// produto -- mesma regra de CheckoutSessionItem.
model PaymentLinkItem {
  id                String          @id @default(uuid())
  paymentLinkId     String          @map("payment_link_id")
  productId         String?         @map("product_id")
  productExternalId String?         @map("product_external_id")
  name              String
  description       String?
  quantity          Int             @default(1)
  unitPrice         Int             @map("unit_price")
  totalPrice        Int             @map("total_price")
  imageUrl          String?         @map("image_url")
  metadata          Json?
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  paymentLink       PaymentLink     @relation(fields: [paymentLinkId], references: [id], onDelete: Cascade)
  product           Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([paymentLinkId])
  @@index([productId])
  @@map("payment_link_items")
}

// ============================================================================
// REFUND
// ============================================================================

model Refund {
  id           String        @id @default(uuid())
  paymentId    String        @map("payment_id")
  amount       Int
  feeRefunded  Int           @default(0) @map("fee_refunded")
  reason       String?
  status       RefundStatus
  processedAt  DateTime?     @map("processed_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  payment      Payment       @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("refunds")
}

// ============================================================================
// WEBHOOKS
// ============================================================================

model WebhookConfig {
  id          String        @id @default(uuid())
  storeId     String        @map("store_id")
  url         String
  secret      String        // Encrypted with AES-256-GCM
  prefix      String        // First 12 chars of secret for identification (whsec_xxx...)
  events      String[]
  isActive    Boolean       @default(true) @map("is_active")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  store       Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  webhookLogs WebhookLog[]
  inboxEvents WebhookInboxEvent[]

  @@map("webhook_configs")
}

model WebhookInboxEvent {
  id              String        @id @default(uuid())
  storeId         String        @map("store_id")
  configId        String        @map("config_id")
  eventType       String        @map("event_type")
  payload         Json
  requestHeaders  Json?         @map("request_headers")
  requestId       String?       @map("request_id")
  deliveryId      String?       @map("delivery_id")
  outboxEventId   String?       @map("outbox_event_id")
  paymentId       String?       @map("payment_id")
  signatureValid  Boolean       @default(false) @map("signature_valid")
  receivedAt      DateTime      @default(now()) @map("received_at")

  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  config          WebhookConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  payment         Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([configId, receivedAt])
  @@index([storeId, receivedAt])
  @@index([outboxEventId])
  @@map("webhook_inbox_events")
}

model WebhookLog {
  id              String        @id @default(uuid())
  configId        String        @map("config_id")
  paymentId       String?       @map("payment_id")
  aggregateType   String?       @map("aggregate_type")
  aggregateId     String?       @map("aggregate_id")
  outboxEventId   String?       @map("outbox_event_id")
  requestId       String?       @map("request_id")
  eventType       String        @map("event_type")
  payload         Json
  requestHeaders  Json?         @map("request_headers")
  responseStatus  Int?          @map("response_status")
  responseBody    String?       @map("response_body") @db.Text
  status          WebhookDeliveryStatus @default(PENDING)
  attempt         Int           @default(1)
  maxAttempts     Int           @default(5) @map("max_attempts")
  nextRetryAt     DateTime?     @map("next_retry_at")
  deliveredAt     DateTime?     @map("delivered_at")
  failedAt        DateTime?     @map("failed_at")
  lastError       String?       @map("last_error") @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")

  config          WebhookConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  payment         Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@unique([configId, outboxEventId])
  @@index([configId, deliveredAt])
  @@index([status, nextRetryAt])
  @@index([outboxEventId, status])
  @@index([outboxEventId])
  @@index([requestId])
  @@index([aggregateType, aggregateId])
  @@map("webhook_logs")
}

// ============================================================================
// ALERTS
// ============================================================================

model AlertConfig {
  id              String        @id @default(uuid())
  storeId         String        @map("store_id")
  name            String
  channel         AlertChannel
  encryptedConfig Json          @map("encrypted_config")
  configPreview   Json          @map("config_preview")
  events          String[]
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  store           Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  deliveryLogs    AlertDeliveryLog[]

  @@index([storeId, isActive])
  @@map("alert_configs")
}

model AlertDeliveryLog {
  id              String              @id @default(uuid())
  alertConfigId   String              @map("alert_config_id")
  outboxEventId   String              @map("outbox_event_id")
  paymentId       String?             @map("payment_id")
  eventType       String              @map("event_type")
  channel         AlertChannel
  status          AlertDeliveryStatus @default(PENDING)
  payload         Json
  responseStatus  Int?                @map("response_status")
  responseBody    String?             @map("response_body") @db.Text
  errorMessage    String?             @map("error_message") @db.Text
  attempt         Int                 @default(1)
  maxAttempts     Int                 @default(5) @map("max_attempts")
  nextRetryAt     DateTime?           @map("next_retry_at")
  deliveredAt     DateTime?           @map("delivered_at")
  createdAt       DateTime            @default(now()) @map("created_at")

  alertConfig     AlertConfig         @relation(fields: [alertConfigId], references: [id], onDelete: Cascade)

  @@unique([alertConfigId, outboxEventId])
  @@index([alertConfigId, createdAt])
  @@index([outboxEventId, eventType])
  @@map("alert_delivery_logs")
}

// ============================================================================
// OUTBOX
// ============================================================================

model OutboxEvent {
  id            String       @id @default(uuid())
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  eventType     String       @map("event_type")
  requestId     String?      @map("request_id")
  payload       Json
  status        OutboxStatus @default(PENDING)
  processedAt   DateTime?    @map("processed_at")
  retryCount    Int          @default(0) @map("retry_count")
  maxRetries    Int          @default(5) @map("max_retries")
  nextRetryAt   DateTime?    @map("next_retry_at")
  errorMessage  String?      @map("error_message")
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([status, nextRetryAt])
  @@index([status, nextRetryAt, createdAt])
  @@index([status, processedAt, nextRetryAt, createdAt])
  @@index([requestId])
  @@map("outbox_events")
}

// ============================================================================
// RECEIPTS
// ============================================================================

model Receipt {
  id            String        @id @default(uuid())
  receiptNumber String        @unique @map("receipt_number")
  paymentId     String        @unique @map("payment_id")
  storeId       String        @map("store_id")

  payerName     String?       @map("payer_name")
  payerDocument String?       @map("payer_document")
  payerEmail    String?       @map("payer_email")

  payeeName     String        @map("payee_name")
  payeeDocument String?       @map("payee_document")

  amount        Int
  fee           Int
  netAmount     Int           @map("net_amount")
  currency      String        @default("BRL")
  description   String?

  status        ReceiptStatus @default(ISSUED)
  issuedAt      DateTime      @map("issued_at")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  payment       Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  store         Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("receipts")
}

model ReceiptCounter {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  date      String   // YYYYMMDD
  sequence  Int      @default(0)

  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, date])
  @@map("receipt_counters")
}

// ============================================================================
// IDEMPOTENCY
// ============================================================================

enum IdempotencyKeyStatus {
  PENDING
  COMPLETED
}

model IdempotencyKey {
  id             String                @id @default(uuid())
  key            String
  storeId        String                @map("store_id")
  environment    Environment           @default(TEST)
  requestMethod  String                @default("POST") @map("request_method")
  requestPath    String                @map("request_path")
  requestHash    String                @map("request_hash")
  responseBody   Json?                 @map("response_body")
  responseStatus Int?                  @map("response_status")
  status         IdempotencyKeyStatus  @default(COMPLETED)
  completedAt    DateTime?             @map("completed_at")
  createdAt      DateTime              @default(now()) @map("created_at")
  expiresAt      DateTime              @map("expires_at")

  store          Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([key, storeId, environment])
  @@map("idempotency_keys")
}

// ============================================================================
// API KEY
// ============================================================================

model ApiKey {
  id           String      @id @default(uuid())
  storeId      String      @map("store_id")
  keyHash      String      @map("key_hash")
  prefix       String
  name         String
  environment  Environment @default(TEST)
  lastUsedAt   DateTime?   @map("last_used_at")
  createdAt    DateTime    @default(now()) @map("created_at")
  revokedAt    DateTime?   @map("revoked_at")

  store        Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([prefix, keyHash])
  @@map("api_keys")
}
